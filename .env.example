# Production Server Configuration
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated list of allowed frontend origins, or * for public access)
# In production with Vercel, set to: https://your-vercel-domain.vercel.app
CORS_ORIGINS=*

# Max Concurrent Downloads Limit
MAX_CONCURRENT_JOBS=10

# Media Expiration (in minutes before automatic cleanup from disk)
TEMP_FILE_EXPIRY_MINUTES=60
